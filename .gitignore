.worktrees/
node_modules/
.env
.env.*
!.env.example
__pycache__/
*.pyc
autopilot-work/

# --- Added when the private oddly-relatable repository was created ---
# Work/render output and cached frames (rebuildable) and the duplicate handoff copy
# Copyrighted third-party reference screenshots must not be committed
**/references/
# Keys, certificates, credentials, state, dumps and local assistant state
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials*
*.tfstate*
*.dump
.claude/
# Windows noise
Thumbs.db
desktop.ini

# Project LICENSE removed from this repository at the owner's request (file kept locally, not committed)
/LICENSE

# studio-work: keep projects, assets and rendered videos; drop rebuildable cache/frames (references/ is already ignored above)
studio-work/**/output/cache/
studio-work/**/output/frames/
# handoff-AP74/evidence duplicates bible/concepts/lookdev-richenv evidence
handoff-AP74/evidence/

# AP-78 toolkit build output (reproducible with: node production/cli.mjs build ...); evidence is kept in production/evidence/ap78/
studio-work/short-001-v2-compat-test/
# AP-79 toolkit build outputs (reproducible with node production/cli.mjs build ...); evidence is kept in production/evidence/ap79/
studio-work/short-001-v2-ap79/
studio-work/synthetic-two-member-cast-ap79/
# AP-82 production run output (reproducible with node production/cli.mjs produce ...); evidence is kept in production/evidence/ap82/
studio-work/short-001-production/
# AP-83 studio workspaces (SQLite database, production runs, logs): local data, never committed
studio-work/studio/
studio-work/studio-*/

# Oddly Relatable Studio app (studio-app/): build output, caches and local databases
studio-app/web/.next/
studio-app/web/*.tsbuildinfo
__pycache__/
studio-app/api/*.db

# studio-work restructure (2026-11-28): bulk archive and staging are local only; kit render output is rebuildable
studio-work/_archive/*
!studio-work/_archive/README.md
studio-work/_to_delete/
studio-work/_shared/kits/*/frames*/
studio-work/_shared/kits/*/out/
studio-work/_shared/kits/*/stills/
studio-work/_shared/kits/*/work/
studio-work/_shared/kits/*/vendor-src/
studio-work/_shared/kits/*/node_modules/

