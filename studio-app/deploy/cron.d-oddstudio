# Oddly Relatable Studio scheduled jobs. Install as /etc/cron.d/oddstudio (see studio-app/docs/MAINTENANCE.md).
# Times are the server's local time. The script runs from the current release.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# No nightly backup (removed 2026-11-23, after the disk filled up): deploy.sh makes a backup before every deploy and
# keeps the newest 3. To add the nightly backup back, see studio-app/docs/MAINTENANCE.md.

# Weekly housekeeping, Sunday 04:30, applied (owner decision 2026-11-21, after one verified manual --apply): removes
# old releases and their images, unused images, the build cache above 10GB, and old backups and dumps (the newest of
# each is always kept). For a report only, run maintenance.sh without --apply.
30 4 * * 0 root /srv/stickman/current/studio-app/deploy/maintenance.sh --apply >> /var/log/oddstudio-maintenance.log 2>&1
