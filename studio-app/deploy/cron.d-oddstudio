# Oddly Relatable Studio scheduled jobs. Install as /etc/cron.d/oddstudio (see studio-app/docs/MAINTENANCE.md).
# Times are the server's local time. The script runs from the current release.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# No nightly backup (removed 2026-11-23, after the disk filled up): deploy.sh makes a backup before every deploy and
# keeps the newest 3. To add the nightly backup back, see studio-app/docs/MAINTENANCE.md.

# Weekly housekeeping, Sunday 04:30: a DRY RUN (report only; owner decision 2026-11-23), the same as the file installed on
# the server, so installing this file never starts deleting by itself. To let it remove old releases, images, build
# cache, backups and dumps, add --apply deliberately: see studio-app/docs/MAINTENANCE.md (install step 4).
30 4 * * 0 root /srv/stickman/current/studio-app/deploy/maintenance.sh >> /var/log/oddstudio-maintenance.log 2>&1
