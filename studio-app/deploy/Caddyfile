# Public HTTPS entry point for the dashboard (the only public service of this project).
#   PUBLIC_HOST  a DNS name that resolves to the server (e.g. 13-140-218-113.sslip.io or your own domain)
#   PUBLIC_PORT  the dedicated HTTPS port (8443)
# Port 80 is used only for Let's Encrypt HTTP-01 validation and renewals; any other request there is redirected.
# Postgres, Redis, the API and the worker have no published ports. Caddy sends everything to the dashboard container,
# which forwards /api/* to the API on the private Compose network, with ONE exception: the audio-first media upload
# (PUT /api/episodes/<id>/audio, up to 250 MB of video) goes straight to the API, so it never passes through Next.js
# (whose request-body handling stops at 10 MB when its middleware runs) and is the only route allowed above 50 MB.
{
	http_port 80
	https_port {$PUBLIC_PORT}
	admin off
}

# Plain HTTP: Caddy answers ACME challenges here first; everything else goes to the HTTPS port.
http://{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}:{$PUBLIC_PORT}{uri} permanent
}

{$PUBLIC_HOST}:{$PUBLIC_PORT} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	@media_upload {
		method PUT
		path_regexp ^/api/episodes/[0-9]+/audio$
	}
	handle @media_upload {
		# audio up to 60 MB, video up to 250 MB (audio-first Stage 1b), plus headroom
		request_body {
			max_size 260MB
		}
		reverse_proxy api:8000
	}
	handle {
		request_body {
			max_size 50MB
		}
		reverse_proxy web:3000
	}
}
