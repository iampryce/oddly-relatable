# Copy to .env next to docker-compose.yml and fill in. Never commit .env (it is git-ignored).

# Database password (any long random string): python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Sign-in. SESSION_SECRET: at least 32 random characters (python -c "import secrets;print(secrets.token_hex(32))").
# OWNER_PASSWORD_HASH: run `python -m oddstudio.auth hash` in studio-app/api and paste the output.
SESSION_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# false while the dashboard is reached through an SSH tunnel over plain HTTP; true once it is served over HTTPS.
COOKIE_SECURE=false

# Media storage: "local" (server volume) or "s3".
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=oddly-relatable/
AWS_REGION=
# Prefer an instance role; otherwise an IAM user limited to this bucket prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI providers (optional; choose which one is used in Settings). Paid per use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Voices (optional): ElevenLabs. Piper (free, local) needs no key but a `piper` binary and voice models on the worker.
ELEVENLABS_API_KEY=

# YouTube channel (optional until publishing). OAuth client for the YouTube Data API v3 with the
# youtube.upload scope, and a refresh token for the channel (see README "YouTube setup").
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
